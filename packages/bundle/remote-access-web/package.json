{
  "name": "@froststarinquire/dsh-remote-access-web",
  "description": "Remote-access bundle for the DSH browser surface: mounts the reverse-tunnel host plugin and pins the directory picker to the in-app browse dialog so a remote operator can add workspaces",
  "version": "0.1.0-rc.6",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wikkd/dsh-remote-access-web.git",
    "directory": "packages/bundle/remote-access-web"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/index.d.ts",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-client-ui-directory-picker-browse": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-host-directory-picker-browse": "^0.1.0-rc.6",
    "@froststarinquire/dsh-remote-access": "^0.1.0-rc.6"
  },
  "scripts": {
    "prepare": "node scripts/prepare.mjs"
  }
}
